{
  "manifest_version": 2,
  "name": "Better Tabs",
  "version": "3.1.0",
  "description": "Manage browser tabs and keep site sessions alive",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "cookies",
    "notifications",
    "sessions",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["lib.js", "background.js"],
    "persistent": true
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Better Tabs",
    "default_icon": "icon.svg"
  },
  "commands": {
    "group-tabs": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Group tabs by domain"
    },
    "sort-tabs": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Sort tabs by site and title"
    },
    "close-duplicates": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Close duplicate tabs"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better-tabs@localhost",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
